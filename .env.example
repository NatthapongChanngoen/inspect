# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ
# (docker-compose จะอ่านค่าจาก .env อัตโนมัติ)

# ---- ฐานข้อมูล PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inspection

# URL ที่แอปใช้ต่อฐานข้อมูล (host = ชื่อ service ใน docker-compose คือ "db")
DATABASE_URL=postgresql://postgres:postgres@db:5432/inspection?schema=public

# ---- Auth.js ----
# สร้างค่าใหม่ด้วย: openssl rand -base64 32
AUTH_SECRET=change-this-to-a-long-random-secret-string
# AUTH_URL: ไม่ต้องตั้งถ้าเปิดผ่าน Cloudflare Tunnel (ใช้ auto-detect จาก trustHost)
#   ถ้าจะ deploy แบบมีโดเมนคงที่ ค่อยตั้ง เช่น AUTH_URL=https://app.example.com
AUTH_TRUST_HOST=true

# ---- Cloudflare Tunnel (เปิดแอปออกอินเทอร์เน็ตผ่าน HTTPS) ----
# token จาก Cloudflare Zero Trust > Tunnels > (tunnel) > Install connector
# ในแดชบอร์ดตั้ง Public Hostname → Service = HTTP://app:3000
CLOUDFLARE_TUNNEL_TOKEN=

# ---- ที่เก็บรูปอัปโหลด (ภายใน container) ----
UPLOAD_DIR=/app/uploads

# ---- บัญชีผู้ดูแลเริ่มต้น (ใช้ตอน seed) ----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin1234

# ---- LINE LIFF (ให้พนักงานเข้าผ่านไลน์) — ดูวิธีตั้งใน LINE_SETUP.md ----
# เว้นว่างไว้ได้ ระบบจะปิดหน้า /line จนกว่าจะใส่ค่า
LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
# Channel Access Token (long-lived) ของ Messaging API channel — ใช้ส่งแจ้งเตือน push เข้า OA
# เว้นว่าง = ปิดการส่งแจ้งเตือน (ระบบทำงานปกติ ไม่ error) ดูวิธีเอา token ใน LINE_SETUP.md
LINE_MESSAGING_TOKEN=

# ---- กันโกงเช็คอิน ----
# ความแม่นยำ GPS สูงสุดที่ยอมรับ (เมตร) — ถ้าสัญญาณแย่กว่านี้จะปฏิเสธ
CHECKIN_MAX_ACCURACY_M=50
# อายุรหัสเซสชันเช็คอิน (นาที)
CHECKIN_SESSION_TTL_MIN=5
